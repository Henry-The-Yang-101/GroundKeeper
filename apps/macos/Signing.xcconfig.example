// Copy to .local/macos/Signing.xcconfig at the repository root.
// Replace YOUR_TEAM_ID with the team shown in Xcode > Settings > Apple Accounts.
GK_CODE_SIGN_IDENTITY = Apple Development
GK_CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// Protected Keychain convenience unlock requires the provisioned app identity.
GK_APP_ENTITLEMENTS = GroundKeeper.Keychain.entitlements
